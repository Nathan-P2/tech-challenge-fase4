# Azure AI Speech (Speech to Text) — portal.azure.com > Speech service > Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Azure AI Language (Text Analytics + Text Analytics for Health)
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/

# Ordem de transcrição: auto (Azure -> Whisper -> referência) | azure | whisper | referencia
TRANSCRIBER=auto
WHISPER_MODEL=small

# Webhook para alertas >= ALTA (Teams / Slack / Azure Logic Apps). Opcional.
ALERT_WEBHOOK_URL=
